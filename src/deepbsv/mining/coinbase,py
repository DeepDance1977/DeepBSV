from __future__ import annotations

from dataclasses import dataclass


class CoinbaseError(ValueError):
    """Fehler beim Parsen oder Verändern einer Coinbase-Transaktion."""


@dataclass(frozen=True, slots=True)
class CoinbaseParts:
    """
    Zerlegte Coinbase-Transaktion für Stratum V1.

    prefix:
        Alles bis einschließlich der Coinbase-scriptSig vor
        dem Extranonce-Bereich.

    suffix:
        Alles nach dem Extranonce-Bereich innerhalb der scriptSig
        sowie die komplette restliche Transaktion.

    script_sig_length:
        Ursprüngliche Länge der Coinbase-scriptSig.

    extranonce_offset:
        Position innerhalb der scriptSig, an der der Extranonce
        eingefügt wird.
    """

    prefix: bytes
    suffix: bytes
    script_sig_length: int
    extranonce_offset: int


def _read_compact_size(
    data: bytes,
    offset: int,
) -> tuple[int, int]:
    """Liest einen Bitcoin CompactSize-Wert."""

    if offset >= len(data):
        raise CoinbaseError(
            "CompactSize-Wert fehlt",
        )

    first = data[offset]

    if first < 253:
        return first, offset + 1

    if first == 253:
        end = offset + 3

        if end > len(data):
            raise CoinbaseError(
                "Ungültiger CompactSize-Wert",
            )

        value = int.from_bytes(
            data[offset + 1:end],
            byteorder="little",
        )

        if value < 253:
            raise CoinbaseError(
                "Nicht minimal codierter CompactSize-Wert",
            )

        return value, end

    if first == 254:
        end = offset + 5

        if end > len(data):
            raise CoinbaseError(
                "Ungültiger CompactSize-Wert",
            )

        value = int.from_bytes(
            data[offset + 1:end],
            byteorder="little",
        )

        if value <= 0xFFFF:
            raise CoinbaseError(
                "Nicht minimal codierter CompactSize-Wert",
            )

        return value, end

    end = offset + 9

    if end > len(data):
        raise CoinbaseError(
            "Ungültiger CompactSize-Wert",
        )

    value = int.from_bytes(
        data[offset + 1:end],
        byteorder="little",
    )

    if value <= 0xFFFFFFFF:
        raise CoinbaseError(
            "Nicht minimal codierter CompactSize-Wert",
        )

    return value, end


def _encode_compact_size(
    value: int,
) -> bytes:
    """Kodiert einen Bitcoin CompactSize-Wert."""

    if value < 0:
        raise CoinbaseError(
            "CompactSize-Wert darf nicht negativ sein",
        )

    if value < 253:
        return bytes([value])

    if value <= 0xFFFF:
        return (
            b"\xfd"
            + value.to_bytes(
                2,
                byteorder="little",
            )
        )

    if value <= 0xFFFFFFFF:
        return (
            b"\xfe"
            + value.to_bytes(
                4,
                byteorder="little",
            )
        )

    if value <= 0xFFFFFFFFFFFFFFFF:
        return (
            b"\xff"
            + value.to_bytes(
                8,
                byteorder="little",
            )
        )

    raise CoinbaseError(
        "CompactSize-Wert ist zu groß",
    )


def _read_first_script_push(
    script_sig: bytes,
) -> int:
    """
    Ermittelt die Länge des ersten Pushes im Coinbase-scriptSig.

    Bei Bitcoin/BSV muss der Block-Height gemäß BIP34 am Anfang
    der Coinbase-scriptSig stehen. Wir setzen den Extranonce direkt
    hinter diesen Height-Push.
    """

    if not script_sig:
        raise CoinbaseError(
            "Coinbase-scriptSig ist leer",
        )

    opcode = script_sig[0]

    if opcode == 0:
        return 1

    if 1 <= opcode <= 75:
        end = 1 + opcode

        if end > len(script_sig):
            raise CoinbaseError(
                "Erster scriptSig-Push ist abgeschnitten",
            )

        return end

    if opcode == 76:
        if len(script_sig) < 2:
            raise CoinbaseError(
                "OP_PUSHDATA1 ist abgeschnitten",
            )

        length = script_sig[1]
        end = 2 + length

        if end > len(script_sig):
            raise CoinbaseError(
                "OP_PUSHDATA1-Daten sind abgeschnitten",
            )

        return end

    if opcode == 77:
        if len(script_sig) < 3:
            raise CoinbaseError(
                "OP_PUSHDATA2 ist abgeschnitten",
            )

        length = int.from_bytes(
            script_sig[1:3],
            byteorder="little",
        )

        end = 3 + length

        if end > len(script_sig):
            raise CoinbaseError(
                "OP_PUSHDATA2-Daten sind abgeschnitten",
            )

        return end

    if opcode == 78:
        if len(script_sig) < 5:
            raise CoinbaseError(
                "OP_PUSHDATA4 ist abgeschnitten",
            )

        length = int.from_bytes(
            script_sig[1:5],
            byteorder="little",
        )

        end = 5 + length

        if end > len(script_sig):
            raise CoinbaseError(
                "OP_PUSHDATA4-Daten sind abgeschnitten",
            )

        return end

    raise CoinbaseError(
        "Coinbase-scriptSig beginnt nicht mit einem Push",
    )


def split_coinbase(
    coinbase_hex: str,
) -> CoinbaseParts:
    """
    Zerlegt eine vollständige BSV-Coinbase-Transaktion.

    Der Extranonce wird direkt hinter dem ersten Push der
    scriptSig eingefügt. Dieser erste Push enthält bei einem
    gültigen BSV-Block die Blockhöhe.

    Die Funktion verändert die Transaktion noch nicht.
    """

    try:
        coinbase = bytes.fromhex(
            coinbase_hex,
        )
    except ValueError as exc:
        raise CoinbaseError(
            "Coinbase enthält ungültiges Hex",
        ) from exc

    if not coinbase:
        raise CoinbaseError(
            "Coinbase ist leer",
        )

    offset = 0

    if len(coinbase) < 4:
        raise CoinbaseError(
            "Coinbase enthält keine vollständige Version",
        )

    offset += 4

    input_count, offset = _read_compact_size(
        coinbase,
        offset,
    )

    if input_count != 1:
        raise CoinbaseError(
            "Eine Coinbase-Transaktion muss genau einen Input besitzen",
        )

    if offset + 36 > len(coinbase):
        raise CoinbaseError(
            "Coinbase-Input ist abgeschnitten",
        )

    previous_output = coinbase[
        offset:offset + 36
    ]

    if previous_output != b"\x00" * 36:
        raise CoinbaseError(
            "Coinbase-Input referenziert keinen Null-Outpoint",
        )

    offset += 36

    script_length_offset = offset

    script_length, offset = _read_compact_size(
        coinbase,
        offset,
    )

    script_start = offset
    script_end = script_start + script_length

    if script_end > len(coinbase):
        raise CoinbaseError(
            "Coinbase-scriptSig ist abgeschnitten",
        )

    if not 2 <= script_length <= 100:
        raise CoinbaseError(
            "Coinbase-scriptSig muss zwischen 2 und 100 Bytes lang sein",
        )

    script_sig = coinbase[
        script_start:script_end
    ]

    extranonce_offset = _read_first_script_push(
        script_sig,
    )

    suffix_start = script_end + 4

    if suffix_start > len(coinbase):
        raise CoinbaseError(
            "Coinbase-Input enthält keine vollständige Sequence",
        )

    prefix = (
        coinbase[:script_length_offset]
        + _encode_compact_size(
            extranonce_offset,
        )
        + script_sig[:extranonce_offset]
    )

    suffix = (
        script_sig[extranonce_offset:]
        + coinbase[suffix_start:]
    )

    return CoinbaseParts(
        prefix=prefix,
        suffix=suffix,
        script_sig_length=script_length,
        extranonce_offset=extranonce_offset,
    )


def build_coinbase(
    parts: CoinbaseParts,
    extranonce: bytes,
) -> bytes:
    """
    Baut aus den Coinbase-Teilen und einem Extranonce
    eine vollständige Coinbase-Transaktion.

    Der Extranonce wird als rohe Bytefolge innerhalb der
    Coinbase-scriptSig eingefügt. Die scriptSig-Länge wird
    entsprechend angepasst.
    """

    if not extranonce:
        raise CoinbaseError(
            "Extranonce darf nicht leer sein",
        )

    new_script_length = (
        parts.script_sig_length
        + len(extranonce)
    )

    if new_script_length > 100:
        raise CoinbaseError(
            "Coinbase-scriptSig würde die maximale Größe von 100 Bytes überschreiten",
        )

    script_length = _encode_compact_size(
        new_script_length,
    )

    return (
        parts.prefix
        + extranonce
        + parts.suffix
        if False
        else _rebuild_coinbase(
            parts,
            extranonce,
            script_length,
        )
    )


def _rebuild_coinbase(
    parts: CoinbaseParts,
    extranonce: bytes,
    script_length: bytes,
) -> bytes:
    """Interne Hilfsfunktion zum Wiederaufbau der Coinbase."""

    prefix_without_length = parts.prefix

    original_length = _encode_compact_size(
        parts.extranonce_offset,
    )

    if not prefix_without_length.endswith(
        original_length,
    ):
        raise CoinbaseError(
            "Interne Coinbase-Struktur ist inkonsistent",
        )

    prefix_body = prefix_without_length[
        :-len(original_length)
    ]

    original_script_prefix = prefix_body[
        -parts.extranonce_offset:
    ]

    transaction_prefix = prefix_body[
        :-parts.extranonce_offset
    ]

    return (
        transaction_prefix
        + script_length
        + original_script_prefix
        + extranonce
        + parts.suffix
    )


def coinbase_txid(
    coinbase: bytes,
) -> bytes:
    """
    Berechnet die TXID einer Coinbase-Transaktion.

    Die Rückgabe erfolgt in der internen Bitcoin-Byte-Reihenfolge.
    """

    import hashlib

    return hashlib.sha256(
        hashlib.sha256(coinbase).digest()
    ).digest()


def coinbase_txid_hex(
    coinbase: bytes,
) -> str:
    """Berechnet die Coinbase-TXID und gibt sie als Hex zurück."""

    return coinbase_txid(
        coinbase,
    ).hex()
