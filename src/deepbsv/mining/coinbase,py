from __future__ import annotations

import hashlib


def double_sha256(data: bytes) -> bytes:
    """Berechnet SHA256(SHA256(data))."""

    return hashlib.sha256(
        hashlib.sha256(data).digest()
    ).digest()


def insert_extranonce(
    coinbase_hex: str,
    extranonce1_hex: str,
    extranonce2_hex: str,
) -> bytes:
    """
    Fügt Extranonce1 und Extranonce2 in eine vorhandene Coinbase ein.

    Die Coinbase wird als vollständige Transaktion erwartet. Die
    Extranonces werden an der Stelle des ScriptSig-Platzhalters eingefügt.
    Für DeepBSV wird dafür ein eindeutiger Marker verwendet.

    Args:
        coinbase_hex:
            Hex-kodierte Coinbase-Transaktion.
        extranonce1_hex:
            Hex-kodierte Extranonce1.
        extranonce2_hex:
            Hex-kodierte Extranonce2.

    Returns:
        Die vollständig zusammengesetzte Coinbase als Bytes.

    Raises:
        ValueError:
            Wenn die Eingaben kein gültiges Hex enthalten oder der
            Extranonce-Marker nicht gefunden wird.
    """

    try:
        coinbase = bytes.fromhex(coinbase_hex)
        extranonce1 = bytes.fromhex(extranonce1_hex)
        extranonce2 = bytes.fromhex(extranonce2_hex)
    except ValueError as exc:
        raise ValueError(
            "Coinbase oder Extranonce enthält ungültiges Hex",
        ) from exc

    marker = b"\xde\xad\xbe\xef"

    marker_position = coinbase.find(marker)

    if marker_position < 0:
        raise ValueError(
            "Extranonce-Marker wurde in der Coinbase nicht gefunden",
        )

    return (
        coinbase[:marker_position]
        + extranonce1
        + extranonce2
        + coinbase[
            marker_position + len(marker):
        ]
    )


def calculate_coinbase_hash(
    coinbase: bytes,
) -> bytes:
    """Berechnet den Double-SHA256-Hash der Coinbase."""

    if not coinbase:
        raise ValueError(
            "Coinbase darf nicht leer sein",
        )

    return double_sha256(coinbase)


def calculate_merkle_root(
    coinbase_hash: bytes,
    merkle_proof: list[str] | tuple[str, ...],
) -> bytes:
    """
    Berechnet die Merkle-Root aus Coinbase-Hash und BSV-Merkle-Proof.

    Die Hashes des BSV-Merkle-Proofs werden in der von der Node
    gelieferten Byte-Reihenfolge verarbeitet.
    """

    if len(coinbase_hash) != 32:
        raise ValueError(
            "Coinbase-Hash muss genau 32 Bytes enthalten",
        )

    current_hash = coinbase_hash

    for branch_hex in merkle_proof:
        try:
            branch = bytes.fromhex(branch_hex)
        except ValueError as exc:
            raise ValueError(
                "Merkle-Proof enthält ungültiges Hex",
            ) from exc

        if len(branch) != 32:
            raise ValueError(
                "Jeder Merkle-Proof-Hash muss genau 32 Bytes enthalten",
            )

        current_hash = double_sha256(
            current_hash + branch,
        )

    return current_hash


def build_coinbase(
    coinbase_hex: str,
    extranonce1_hex: str,
    extranonce2_hex: str,
) -> bytes:
    """
    Erstellt die vollständige Coinbase für einen Stratum-Job.

    Die Funktion setzt Extranonce1 und Extranonce2 in die vom
    DeepBSV-Coinbase-Format vorgesehene Markerposition ein.
    """

    return insert_extranonce(
        coinbase_hex=coinbase_hex,
        extranonce1_hex=extranonce1_hex,
        extranonce2_hex=extranonce2_hex,
    )


def build_merkle_root(
    coinbase: bytes,
    merkle_proof: list[str] | tuple[str, ...],
) -> bytes:
    """Erstellt die Merkle-Root direkt aus der vollständigen Coinbase."""

    coinbase_hash = calculate_coinbase_hash(
        coinbase,
    )

    return calculate_merkle_root(
        coinbase_hash=coinbase_hash,
        merkle_proof=merkle_proof,
    )
